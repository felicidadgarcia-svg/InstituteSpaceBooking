digraph ER {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.6", ranksep="0.9", label="Institute Space Booking — Entity Relationship Model", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#35566f", penwidth=1.5, dir=none];
  SPACES [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#17324d" COLSPAN="2"><FONT COLOR="white"><B>SPACES</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK id</B></TD><TD ALIGN="LEFT">BIGINT</TD></TR>
      <TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
      <TR><TD ALIGN="LEFT">space_type</TD><TD ALIGN="LEFT">ENUM</TD></TR>
      <TR><TD ALIGN="LEFT">building / floor_label</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
      <TR><TD ALIGN="LEFT">capacity</TD><TD ALIGN="LEFT">INT</TD></TR>
      <TR><TD ALIGN="LEFT">equipment</TD><TD ALIGN="LEFT">JSON</TD></TR>
      <TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
    </TABLE>>];
  USERS [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#315d78" COLSPAN="2"><FONT COLOR="white"><B>USERS</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK id</B></TD><TD ALIGN="LEFT">BIGINT</TD></TR>
      <TR><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR>
      <TR><TD ALIGN="LEFT">email (unique)</TD><TD ALIGN="LEFT">VARCHAR(254)</TD></TR>
      <TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">ENUM</TD></TR>
    </TABLE>>];
  BOOKINGS [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#2f709e" COLSPAN="2"><FONT COLOR="white"><B>BOOKINGS</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK id</B></TD><TD ALIGN="LEFT">BIGINT</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK space_id</B></TD><TD ALIGN="LEFT">BIGINT</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK user_id</B> (nullable)</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
      <TR><TD ALIGN="LEFT">booked_by / email</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
      <TR><TD ALIGN="LEFT">purpose</TD><TD ALIGN="LEFT">VARCHAR(250)</TD></TR>
      <TR><TD ALIGN="LEFT">booking_date</TD><TD ALIGN="LEFT">DATE</TD></TR>
      <TR><TD ALIGN="LEFT">start_time / end_time</TD><TD ALIGN="LEFT">TIME</TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR>
    </TABLE>>];
  SPACES -> BOOKINGS [label="1 to many\nspace has bookings"];
  USERS -> BOOKINGS [label="0..1 user per booking\nuser may have many bookings"];
}
